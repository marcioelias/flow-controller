JWT_SECRET=replace-with-a-64-char-random-string
FLOW_RETENTION_DAYS=30

# Per-worker UDP packet queue (packets, count-bounded). Default 65536 (~90 MB
# worst case per worker). Raise only on hosts with RAM to spare.
#COLLECTOR_QUEUE_CAPACITY=65536

# LLM explainability (Phase 9 — optional)
# Set LLM_ENABLED=true and start ollama profile: docker compose --profile llm up
LLM_ENABLED=false
LLM_ENDPOINT=http://ollama:11434
LLM_MODEL=qwen2.5:3b
